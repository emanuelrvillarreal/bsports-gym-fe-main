# Archivos .env de Vite para Vue/TanStack
# Cada archivo corresponde a un modo de build.
# El campo "environment" en deploy.yml selecciona el modo: vite build --mode <valor>

# .env.production  (deploy.yml: environment: production)
VITE_API_URL=https://app.blueopendata.com/mi-app/api
VITE_FEATURE_NEW_UI=true
VITE_APP_TITLE=Mi App

# ---

# .env.staging  (deploy.yml: environment: staging)
VITE_API_URL=https://stg.blueopendata.com/mi-app/api
VITE_FEATURE_NEW_UI=true
VITE_APP_TITLE=Mi App (Staging)

# ---

# .env.local  (deploy.yml local: environment: local)
VITE_API_URL=http://localhost:9050/api
VITE_FEATURE_NEW_UI=true
VITE_APP_TITLE=Mi App (Local)
